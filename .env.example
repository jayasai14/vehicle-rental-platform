# ==========================================
# DriveElite Vehicle Rental Platform - Environment Configuration Example
# ==========================================

# Spring / Database
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vehicle_rental_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=vehicle_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Security (Must be at least 256 bits / 64 hex characters)
JWT_SECRET=your_jwt_secret_hex_encoded_key_minimum_64_characters_long

# File Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Seed Data (Set to false in production)
APP_SEED_ENABLED=true

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
